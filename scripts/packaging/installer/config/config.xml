<!-- Placeholders @...@ are filled in by scripts/deploy/stage_installer.py. -->
<Installer>
    <Name>MNE-CPP</Name>
    <Version>@MNE_CPP_VERSION@</Version>
    <Title>MNE-CPP @MNE_CPP_VERSION@</Title>
    <Publisher>MNE-CPP</Publisher>
    <ProductUrl>https://mne-cpp.github.io/</ProductUrl>
    <TargetDir>@HomeDir@/MNE-CPP</TargetDir>
    <AdminTargetDir>@ApplicationsDir@/MNE-CPP</AdminTargetDir>
    <StartMenuDir>MNE-CPP</StartMenuDir>
    <MaintenanceToolName>MNE-CPP Maintenance Tool</MaintenanceToolName>
    <AllowSpaceInPath>true</AllowSpaceInPath>
    <AllowNonAsciiCharacters>true</AllowNonAsciiCharacters>
    <!-- A translation that does not exist keeps every page in English whatever the system language -->
    <Translations>
        <Translation>ifw_en</Translation>
    </Translations>

    <InstallerApplicationIcon>installer</InstallerApplicationIcon>
    <InstallerWindowIcon>installer.png</InstallerWindowIcon>
    <WizardStyle>Modern</WizardStyle>
    <WizardDefaultWidth>960</WizardDefaultWidth>
    <WizardDefaultHeight>700</WizardDefaultHeight>
    <WizardMinimumWidth>860</WizardMinimumWidth>
    <WizardMinimumHeight>660</WizardMinimumHeight>
    <WizardShowPageList>true</WizardShowPageList>
    <PageListPixmap>sidebar.png</PageListPixmap>
    <TitleColor>#1a1a2e</TitleColor>
    <StyleSheet>style.qss</StyleSheet>

    <ControlScript>controller.qs</ControlScript>
</Installer>
