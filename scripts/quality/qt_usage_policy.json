  "kept": {
    "$comment": "Library -> { use: reason } for Qt kept by decision D16.",
    "disp": {
      "SvgWriter (QPaintEngine)": "Replaces QSvgGenerator so the vector export of widgets needs Qt Gui only; dropping the Qt Svg module raised the disp ceilings once (tokens 6025 -> 6159, public header includes 110 -> 112).",
      "QWindow hosts and scene viewports (phase 3)": "ChannelWindow (QWindow + QRhi swap chain) next to the ChannelRhiView QRhiWidget host, and SceneViewport replacing the QGraphicsView scenes, raised the disp ceilings once (tokens 4846 -> 4885, public header includes 82 -> 89); phase 4 moved the widgets out (tokens 4885 -> 1624, public header includes 89 -> 25)."
    },
    "disp3D": {
      "BrainWindow host and GPU overlay (phase 3)": "BrainWindow (QWindow + QRhi swap chain), the forwarding BrainView host and the overlay painted into the GPU pass instead of child QLabels raised the disp3D ceilings once (tokens 1633 -> 1961); phase 4 moved the QRhiWidget host to disp3D_widgets (tokens 1961 -> 1857)."
    },
    "disp_widgets": {
      "QRhiWidget hosts (phase 4)": "ChannelRhiView and the other Widgets plots, viewers and panels moved here from disp so the display cores need Qt Gui only; the QRhiWidget hosts stay because widget overlays and WebAssembly embedding need them."
    },
    "disp3D_widgets": {
      "BrainView QRhiWidget host (phase 4)": "Thin QRhiWidget host and context menu of the brain view, moved out of disp3D so the renderer core needs Qt Gui only."
    }
  },
