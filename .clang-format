# .clang-format — MNE-CPP code style (clang-format 21.1.8, pinned in tools/quality/check_format.py).
# Follows the class templates in resources/wizards/mnecpp and the conventions in
# doc/website/docs/development/contr-style.mdx.
Language: Cpp
BasedOnStyle: LLVM
Standard: c++17

# --- Indentation ---
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
AccessModifierOffset: -4          # public:/protected:/private: at the class brace column
NamespaceIndentation: None
IndentCaseLabels: true
IndentPPDirectives: None

# --- Braces: Allman for types and functions, attached for control flow ---
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterStruct: true
  AfterUnion: true
  AfterEnum: true
  AfterNamespace: true
  AfterFunction: true
  AfterControlStatement: Never
  AfterCaseLabel: false
  AfterExternBlock: false
  BeforeCatch: false
  BeforeElse: false
  BeforeLambdaBody: false
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true

# --- Constructor initializers: leading colon and commas, one per line ---
BreakConstructorInitializers: BeforeComma
PackConstructorInitializers: Never
ConstructorInitializerIndentWidth: 0

# --- Lines and wrapping: never re-wrap long lines or comments ---
ColumnLimit: 0
ReflowComments: false
CommentPragmas: '^ *(//=+|/\*\*<)'
MaxEmptyLinesToKeep: 2
KeepEmptyLines:
  AtStartOfBlock: false
  AtStartOfFile: false

# --- Alignment (contr-style: align parameters and member columns) ---
AlignAfterOpenBracket: Align
AlignOperands: DontAlign
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0
BinPackParameters: true
BinPackArguments: true

# --- Spacing ---
PointerAlignment: Left            # Type* var, Type& var (contr-style examples)
ReferenceAlignment: Pointer
DerivePointerAlignment: false
SpaceBeforeParens: ControlStatements
SpaceAfterTemplateKeyword: false
SpaceAfterCStyleCast: false
SpacesInParens: Never
SpacesInSquareBrackets: false
SpaceBeforeCpp11BracedList: false
Cpp11BracedListStyle: true

# --- Short forms: always expand ---
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AllowShortLambdasOnASingleLine: Inline
AllowShortEnumsOnASingleLine: false

# --- Includes and comments ---
SortIncludes: Never               # include order is grouped by banner sections
SortUsingDeclarations: Never
FixNamespaceComments: false
SpacesBeforeTrailingComments: 1
