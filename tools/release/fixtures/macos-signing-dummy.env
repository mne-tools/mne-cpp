#
# Placeholder values of the eight APPLE_* signing secrets for the macOS signing
# pipeline test (.github/workflows/macos-signing-test.yml) and the unit tests.
# They are deliberately invalid: production signing rejects every one of them.
# Never store them as repository or environment secrets.
APPLE_APPLICATION_CERT_BASE64=TEST_ONLY_NOT_A_REAL_CERTIFICATE
APPLE_APPLICATION_CERT_PASSWORD=TEST_ONLY_PASSWORD
APPLE_ID=test-signing@example.invalid
APPLE_ID_PASSWORD=TEST_ONLY_APP_PASSWORD
APPLE_INSTALLER_CERT_BASE64=TEST_ONLY_NOT_A_REAL_CERTIFICATE
APPLE_INSTALLER_CERT_PASSWORD=TEST_ONLY_PASSWORD
APPLE_KEYCHAIN_PASSWORD=TEST_ONLY_PASSWORD
APPLE_TEAM_ID=TESTONLY00
