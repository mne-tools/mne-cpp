#[=======================================================================[.rst:
MneEmbedFile
------------

Script mode (``cmake -P``): writes a C++ source that holds the bytes of a file, so data such as the fonts of
mne_viz is compiled into the library instead of being looked up at run time.

Variables:

``INPUT``
  File to embed.
``OUTPUT``
  Generated .cpp file.
``SYMBOL``
  Name of the array in namespace ``NAMESPACE``; ``<SYMBOL>Size`` holds its size in bytes.
``NAMESPACE``
  C++ namespace of the symbols.
#]=======================================================================]

foreach(_var INPUT OUTPUT SYMBOL NAMESPACE)
  if(NOT DEFINED ${_var})
    message(FATAL_ERROR "MneEmbedFile: ${_var} is not set")
  endif()
endforeach()

file(READ "${INPUT}" _hex HEX)
string(LENGTH "${_hex}" _digits)
math(EXPR _size "${_digits} / 2")

# Sixteen bytes per line, each as 0xNN
string(REPEAT "[0-9a-f]" 32 _line)
string(REGEX REPLACE "(${_line})" "\\1\n" _hex "${_hex}")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _hex "${_hex}")

file(WRITE "${OUTPUT}.tmp"
  "// Generated by cmake/MneEmbedFile.cmake from ${INPUT}; do not edit.\n"
  "#include <cstddef>\n\n"
  "namespace ${NAMESPACE}\n{\n\n"
  "extern const unsigned char ${SYMBOL}[];\n"
  "extern const std::size_t ${SYMBOL}Size;\n\n"
  "alignas(16) const unsigned char ${SYMBOL}[${_size}] = {\n${_hex}\n};\n\n"
  "const std::size_t ${SYMBOL}Size = ${_size};\n\n"
  "} // namespace ${NAMESPACE}\n")
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
