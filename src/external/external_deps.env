#
# Single source of truth for external dependency versions consumed across
# mne-cpp (local contributor setup and CI workflows alike). Bump a version
# here once and every consumer picks it up.
#
# Skigen (header-only ML library, cloned by git ref):
#   SKIGEN_RELEASE_REF  Immutable tag pinned for reproducible release builds
#                       (release-*.yml workflows, default for local init).
#   SKIGEN_DEV_REF      Moving branch for ongoing co-development
#                       (staging.yml / PR / reusable CI workflows).
#
# Qt / Eigen / ONNX Runtime (prebuilt artifacts, downloaded by version):
#   QT_MIN_VERSION      Oldest Qt release covered by the compatibility matrix.
#   QT_VERSION          Default and newest supported Qt release.
#   EMSCRIPTEN_VERSION  Emscripten SDK for every WASM build; Qt rejects a mismatch
#                       with the one its WASM prebuild used. (Not EMSDK_*: sourcing
#                       emsdk_env unsets those.)
#   EIGEN_VERSION        Eigen release used for the prebuilt artifact.
#   ONNXRUNTIME_VERSION  ONNX Runtime release used for the prebuilt artifact.
#
# NOTE: When bumping EIGEN_VERSION, also update the static version + token in
# .github/workflows/buildeigenartifacts.yml (used in the asset name).
#
# Consumed by:
#   - src/external/init.sh / init.bat            (local contributor setup)
#   - scripts/ci/clone_skigen.sh / .bat          (CI: skigen clone)
#   - scripts/ci/download_toolchain.sh / .bat    (CI: eigen/onnx default version)
#   - .github/workflows/build{eigen,onnxruntime}artifacts.yml (producers)

SKIGEN_RELEASE_REF=v1.1.0
SKIGEN_DEV_REF=staging

QT_MIN_VERSION=6.10.0
QT_VERSION=6.12.0
EMSCRIPTEN_VERSION=5.0.5
EIGEN_VERSION=5.0.1
ONNXRUNTIME_VERSION=1.31.0
